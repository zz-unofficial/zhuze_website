---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'

type ImageItem = {
  src: ImageMetadata
  alt: string
  rotation?: number
}

type Props = {
  images: ImageItem[]
}

const { images } = Astro.props
---

<div class='image-grid'>
  {
    images.map((image) => (
      <div class='image-grid-item'>
        <Image
          src={image.src}
          alt={image.alt}
          style={`--image-rotation: ${image.rotation ?? 0}deg`}
        />
      </div>
    ))
  }
</div>

<style>
  .image-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    margin: 1.5rem 0;
  }

  .image-grid-item {
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 0.5rem;
  }

  .image-grid-item :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transform: rotate(var(--image-rotation));
  }

  @media (max-width: 40rem) {
    .image-grid {
      gap: 0.5rem;
    }

    .image-grid-item {
      border-radius: 0.35rem;
    }
  }
</style>
