---
import type { EducationItem } from '@/site-config'

interface Props {
  items: EducationItem[]
}

const { items } = Astro.props

const images = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/**/*.{jpeg,jpg,png,gif,avif,webp}'
)
const entries = await Promise.all(
  items.map(async (item) => {
    const loadImage = images[item.logo]
    if (!loadImage)
      throw new Error(`"${item.logo}" does not exist in the "src/assets" directory`)

    return { ...item, image: (await loadImage()).default }
  })
)
---

<section class='education-section'>
  <h2>Education</h2>
  <div class='education-list'>
    {
      entries.map((entry) => (
        <article class='education-card'>
          <div>
            <h3>
              <a href={entry.website} target='_blank' rel='noreferrer'>{entry.institution}</a>
            </h3>
            <p>{entry.programme}</p>
            <p>{entry.period}</p>
          </div>
          <img class='education-logo' src={entry.image.src} alt={entry.logoAlt} />
        </article>
      ))
    }
  </div>
</section>

<style>
  .education-section {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .education-section h2 {
    margin: 0;
    font-size: 1.5rem;
    font-weight: 600;
  }

  .education-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .education-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    border: 1px solid hsl(var(--border));
    border-radius: 1.5rem;
    padding: 1.75rem 2rem;
    background: hsl(var(--muted));
  }

  .education-card h3 {
    margin: 0;
    font-size: clamp(1.2rem, 2.5vw, 1.75rem);
    line-height: 1.25;
  }

  .education-card h3 a {
    color: inherit;
    text-decoration: none;
  }

  .education-card h3 a:hover {
    color: hsl(var(--primary));
  }

  .education-card p {
    margin: 0.65rem 0 0;
    color: hsl(var(--muted-foreground));
    font-size: 1rem;
    line-height: 1.55;
  }

  .education-logo {
    width: 7rem;
    height: 7rem;
    flex: none;
    object-fit: contain;
  }

  @media (max-width: 34rem) {
    .education-card {
      gap: 1.25rem;
      border-radius: 1rem;
      padding: 1.25rem;
    }

    .education-logo {
      width: 4.5rem;
      height: 4.5rem;
    }
  }
</style>
