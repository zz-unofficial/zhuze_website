---
import type { CollectionEntry } from 'astro:content'

import { Button } from 'astro-pure/user'

interface Props {
  items: CollectionEntry<'blog'>[]
}

const { items } = Astro.props
const posts = items.map((post) => {
  const image = post.data.heroImage?.src
  const imageSrc = image ? (typeof image === 'string' ? image : image.src) : undefined
  const date = post.data.updatedDate ?? post.data.publishDate

  return {
    ...post,
    date: date.toLocaleDateString('en-US', {
      day: 'numeric',
      month: 'short',
      year: 'numeric'
    }),
    href: `/blog/${post.id}`,
    imageSrc
  }
})
---

<section class='posts-section'>
  <h2>Posts</h2>
  {
    posts.length > 0 ? (
      <>
        <div class='post-list'>
          {posts.map((post) => (
            <a class:list={['post-card', !post.imageSrc && 'post-card--text-only']} href={post.href}>
              <div class='post-content'>
                <div class='post-heading'>
                  <h3>{post.data.title}</h3>
                  <time datetime={post.data.publishDate.toISOString()}>{post.date}</time>
                </div>
                <p class='post-description'>{post.data.description}</p>
                {
                  post.data.tags.length > 0 && (
                    <ul class='post-tags' aria-label='Tags'>
                      {post.data.tags.map((tag) => (
                        <li>{tag}</li>
                      ))}
                    </ul>
                  )
                }
              </div>
              {
                post.imageSrc && (
                  <div class='post-image-wrap'>
                    <img src={post.imageSrc} alt={post.data.heroImage?.alt ?? post.data.title} />
                  </div>
                )
              }
            </a>
          ))}
        </div>
        <Button title='More posts' class='w-fit self-end' href='/blog' variant='ahead' />
      </>
    ) : (
      <p class='text-muted-foreground'>No posts published yet.</p>
    )
  }
</section>

<style>
  .posts-section,
  .post-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .posts-section h2 {
    margin: 0;
    font-size: 1.5rem;
    font-weight: 600;
  }

  .post-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(14rem, 25rem);
    overflow: hidden;
    border: 1px solid hsl(var(--border));
    border-radius: 1.5rem;
    background: hsl(var(--muted));
    color: inherit;
    text-decoration: none;
    transition: border-color 150ms ease, box-shadow 150ms ease;
  }

  .post-card:hover {
    border-color: hsl(var(--foreground) / 0.25);
    box-shadow: 0 0.35rem 1.25rem hsl(var(--foreground) / 0.08);
  }

  .post-card--text-only {
    grid-template-columns: 1fr;
  }

  .post-content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
    padding: 1.5rem 2rem;
  }

  .post-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .post-heading h3 {
    margin: 0;
    font-size: clamp(1.2rem, 2.2vw, 1.6rem);
    line-height: 1.3;
  }

  .post-heading time {
    flex: none;
    color: hsl(var(--muted-foreground));
    font-size: 0.9rem;
    white-space: nowrap;
  }

  .post-description {
    display: -webkit-box;
    margin: 0.8rem 0 0;
    overflow: hidden;
    color: hsl(var(--muted-foreground));
    font-size: 1rem;
    line-height: 1.55;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin: 1rem 0 0;
    padding: 0;
    color: hsl(var(--muted-foreground));
    list-style: none;
  }

  .post-image-wrap {
    position: relative;
    min-height: 13rem;
    background: hsl(var(--muted));
  }

  .post-image-wrap::before {
    position: absolute;
    z-index: 1;
    inset: 0;
    background: linear-gradient(to right, hsl(var(--muted)), transparent 45%);
    content: '';
  }

  .post-image-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 40rem) {
    .post-card {
      grid-template-columns: 1fr;
      border-radius: 1rem;
    }

    .post-content {
      padding: 1.25rem;
    }

    .post-heading {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.35rem;
    }

    .post-image-wrap {
      min-height: 0;
      height: min(60vw, 18rem);
      order: -1;
    }

    .post-image-wrap::before {
      background: linear-gradient(to bottom, hsl(var(--muted)), transparent 45%);
    }
  }
</style>
