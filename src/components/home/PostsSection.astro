---
import type { PostCollection } from '@/site-config'
import PostCollectionCards from '@/components/posts/PostCollectionCards.astro'

interface Props {
  items: PostCollection[]
  counts: Record<string, number>
}

const { items, counts } = Astro.props
---

<section class='posts-section'>
  <h2>Posts</h2>
  {
    items.length > 0 ? (
      <PostCollectionCards {items} {counts} />
    ) : (
      <p class='text-muted-foreground'>No post collections published yet.</p>
    )
  }
</section>

<style>
  .posts-section {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .posts-section h2 {
    margin: 0;
    font-size: 1.5rem;
    font-weight: 600;
  }
</style>
