---
import { cn } from 'astro-pure/utils'

type Props = {
  class?: string
  title: string
  titleClass?: string
  contentClass?: string
}

const {
  class: className,
  title,
  titleClass,
  contentClass
} = Astro.props as Props
---

<section class={cn('flex flex-col gap-y-5 md:flex-row md:gap-y-0', className)}>
  <div class={cn('text-xl font-medium md:min-w-36', titleClass)}>
    <h2>{title}</h2>
  </div>
  <div class={cn('flex flex-1 flex-col gap-y-3', contentClass)}>
    <slot />
  </div>
</section>
