---
import type { HonorItem } from '@/site-config'

interface Props {
  items: HonorItem[]
}

const { items } = Astro.props

const images = import.meta.glob<{ default: ImageMetadata }>(
  '/src/**/*.{jpeg,jpg,png,gif,avif,webp}'
)
const entries = await Promise.all(
  items.map(async (item) => {
    const loadImage = images[item.image]
    if (!loadImage)
      throw new Error(`"${item.image}" does not exist in the "src" directory`)

    const isExternal = 'link' in item
    return {
      ...item,
      image: (await loadImage()).default,
      href: isExternal ? item.link : `/honors/${item.slug}`,
      isExternal
    }
  })
)
---

<div class='honor-list'>
  {
    entries.map((entry) => (
      <article class='honor-card'>
        <figure class='honor-media'>
          <img class='honor-image' src={entry.image.src} alt={entry.imageAlt} loading='lazy' />
        </figure>
        <div class='honor-content'>
          <h3>
            <a
              href={entry.href}
              target={entry.isExternal ? '_blank' : undefined}
              rel={entry.isExternal ? 'noreferrer' : undefined}
            >
              {entry.title}
            </a>
          </h3>
          <p class='honor-description'>{entry.description}</p>
          {
            entry.tags.length > 0 && (
              <ul class='honor-tags' aria-label='Categories'>
                {entry.tags.map((tag) => (
                  <li>{tag}</li>
                ))}
              </ul>
            )
          }
          <p class='honor-date'>{entry.date}</p>
        </div>
      </article>
    ))
  }
</div>

<style>
  .honor-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .honor-card {
    display: grid;
    grid-template-columns: minmax(13rem, 16rem) minmax(0, 1fr);
    min-height: 15.5rem;
    overflow: hidden;
    border: 1px solid hsl(var(--border));
    border-radius: 1.5rem;
    background: hsl(var(--muted));
  }

  .honor-media {
    display: flex;
    align-items: center;
    justify-content: center;
    align-self: stretch;
    margin: 0;
    padding: 1rem;
    border-right: 1px solid hsl(var(--border));
    background: hsl(var(--background) / 0.35);
  }

  .honor-image {
    width: 100%;
    height: 100%;
    max-height: 13.5rem;
    min-height: 0;
    object-fit: contain;
    object-position: center;
  }

  .honor-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    min-width: 0;
    padding: 1.75rem 2rem;
  }

  .honor-content h3 {
    margin: 0;
    font-size: clamp(1.25rem, 2.5vw, 1.75rem);
    line-height: 1.25;
  }

  .honor-content h3 a {
    color: inherit;
    text-decoration: none;
  }

  .honor-content h3 a:hover {
    color: hsl(var(--primary));
  }

  .honor-description,
  .honor-date {
    color: hsl(var(--muted-foreground));
    font-size: 1rem;
    line-height: 1.55;
  }

  .honor-description {
    margin: 0.75rem 0 0;
    white-space: pre-line;
  }

  .honor-date {
    margin: 0.7rem 0 0;
  }

  .honor-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }

  .honor-tags li {
    border: 1px solid hsl(var(--primary) / 0.6);
    border-radius: 0.65rem;
    padding: 0.3rem 0.75rem;
    color: hsl(var(--primary));
    font-size: 0.9rem;
    line-height: 1.25;
  }

  .honor-tags li:nth-child(even) {
    border-color: hsl(187 72% 42% / 0.7);
    color: hsl(187 72% 42%);
  }

  @media (max-width: 40rem) {
    .honor-card {
      grid-template-columns: 1fr;
      border-radius: 1rem;
    }

    .honor-media {
      min-height: min(60vw, 18rem);
      padding: 0.75rem;
      border-right: 0;
      border-bottom: 1px solid hsl(var(--border));
    }

    .honor-content {
      padding: 1.25rem;
    }

  }
</style>
