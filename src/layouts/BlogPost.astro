---
import type { MarkdownHeading } from 'astro'
import type { CollectionEntry } from 'astro:content'

// Plugin styles
import 'katex/dist/katex.min.css'

import { MediumZoom } from 'astro-pure/advanced'
import { ArticleBottom, Copyright, Hero, TOC } from 'astro-pure/components/pages'
import config from 'virtual:config'
import PageLayout from '@/layouts/ContentLayout.astro'
import { Comment, PageInfo } from '@/components/waline'

interface Props {
  post: CollectionEntry<'blog'>
  posts: CollectionEntry<'blog'>[]
  headings: MarkdownHeading[]
  remarkPluginFrontmatter: Record<string, unknown>
}

const {
  post: { id, data },
  posts,
  headings,
  remarkPluginFrontmatter
} = Astro.props

const {
  description,
  heroImage,
  publishDate,
  title,
  updatedDate,
  draft: isDraft,
  comment: enableComment
} = data

const socialImage = heroImage
  ? typeof heroImage.src === 'string'
    ? heroImage.src
    : heroImage.src.src
  : config.socialCard
const articleDate = updatedDate?.toISOString() ?? publishDate.toISOString()
const primaryColor = data.heroImage?.color ?? 'hsl(var(--primary) / var(--un-text-opacity))'
---

<PageLayout
  meta={{ articleDate, description, ogImage: socialImage, title }}
  highlightColor={primaryColor}
  back='/blog'
>
  {!!headings.length && <TOC {headings} slot='sidebar' />}

  <Hero {data} {remarkPluginFrontmatter} slot='header'>
    <Fragment slot='description'>
      {!isDraft && enableComment && <PageInfo comment class='mt-1' />}
    </Fragment>
  </Hero>

  <slot />

  <Fragment slot='bottom'>
    {/* Copyright */}
    <Copyright {data} />
    {/* Article recommend */}
    <ArticleBottom collections={posts} {id} class='mt-3 sm:mt-6' />
    { /* Comment */
    !isDraft && enableComment && <Comment class='mt-3 sm:mt-6' />}
  </Fragment>

  <slot name='bottom-sidebar' slot='bottom-sidebar' />
</PageLayout>

{config.integ.mediumZoom.enable && <MediumZoom />}

<script>
  const mermaidBlocks = Array.from(
    document.querySelectorAll<HTMLElement>('#content .astro-code[data-language="mermaid"]')
  )

  if (mermaidBlocks.length) {
    void (async () => {
      const { default: mermaid } = await import('mermaid')
      const diagrams = mermaidBlocks.flatMap((block, index) => {
        const source = block.querySelector('code')?.textContent?.trim()
        if (!source) return []

        const container = document.createElement('div')
        container.className = 'mermaid-diagram'
        block.replaceWith(container)

        return [{ container, id: `mermaid-${Date.now()}-${index}`, source }]
      })

      mermaid.initialize({
        startOnLoad: false,
        securityLevel: 'strict',
        theme: document.documentElement.classList.contains('dark') ? 'dark' : 'default'
      })

      for (const diagram of diagrams) {
        try {
          const { svg, bindFunctions } = await mermaid.render(diagram.id, diagram.source)
          diagram.container.innerHTML = svg
          bindFunctions?.(diagram.container)
        } catch (error) {
          console.error('Mermaid diagram failed to render:', error)
          const fallback = document.createElement('pre')
          fallback.textContent = diagram.source
          diagram.container.replaceChildren(fallback)
        }
      }
    })()
  }
</script>

<style>
  #content :global(.mermaid-diagram) {
    margin: 1.5rem 0;
    overflow-x: auto;
    border: 1px solid hsl(var(--border) / var(--un-border-opacity));
    border-radius: 1rem;
    background-color: hsl(var(--muted) / var(--un-bg-opacity));
    padding: 1rem;
  }

  #content :global(.mermaid-diagram svg) {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 0 auto;
  }
</style>
