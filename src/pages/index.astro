---
import { Quote } from 'astro-pure/advanced'
import { Button } from 'astro-pure/user'
import HonorsSection from '@/components/honors/HonorsSection.astro'
import PageLayout from '@/layouts/BaseLayout.astro'
import EducationSection from '@/components/home/EducationSection.astro'
import PostsSection from '@/components/home/PostsSection.astro'
import ProfileIntro from '@/components/home/ProfileIntro.astro'
import ProjectsSection from '@/components/projects/ProjectsSection.astro'
import { getCategorizedPosts, getPostCounts } from '@/lib/post-collections'
import config, { education, honors, postCollections, projects } from '@/site-config'

const publishedHonors = honors.filter((honor) => !honor.draft)
const featuredHonors = publishedHonors.slice(0, 2)
const publishedProjects = projects.filter((project) => !project.draft)
const featuredProjects = publishedProjects.slice(0, 2)
const publishedPostCollections = postCollections.filter((collection) => !collection.draft)
const postCounts = getPostCounts(await getCategorizedPosts())

const imagePath = config.logo.src
const images = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/*.{jpeg,jpg,png,gif,avif,webp}'
)
if (!images[imagePath])
  throw new Error(
    `"${imagePath}" does not exist in glob: "src/assets/*.{jpeg,jpg,png,gif,avif,webp}"`
  )
const avatar = (await images[imagePath]()).default
---

<PageLayout meta={{ title: 'Home' }} highlightColor='#659EB9'>
  <main class='flex w-full flex-col items-center'>
    <div class='w-full md:w-4/5 lg:w-5/6'>
      <ProfileIntro {avatar} />
    </div>

    <div id='content' class='animate flex flex-col gap-y-10 md:w-4/5 lg:w-5/6'>
      <section class='home-about'>
        <h2>About</h2>
        <div class='about-content'>
          <div class='about-copy'>
            <p>
              Hi, I’m Zhuze, a sophomore in the <strong>School of Electronics and Information</strong> at
              <strong>Northwestern Polytechnical University</strong>.
            </p>
            <p>
              My current research focuses on <strong>Embodied AI</strong>, with a particular emphasis on
              <strong>World Models</strong>. I am advised by <strong>Professor Dang Zheng</strong> in the
              <strong>PUPL Lab</strong> at NWPU.
            </p>
            <p>
              This site brings together my <strong>projects</strong>, <strong>paper notes</strong>,
              <strong>technical write-ups</strong>, and <strong>award records</strong>, alongside occasional
              writing beyond my main research interests.
            </p>
          </div>
          <Button title='More about me' class='mt-5 w-fit self-end' href='/about' variant='ahead' />
        </div>
      </section>
      <EducationSection items={education} />
      <ProjectsSection
        items={featuredProjects}
        moreHref={publishedProjects.length > featuredProjects.length ? '/projects' : undefined}
      />
      {
        featuredHonors.length > 0 && (
          <HonorsSection
            items={featuredHonors}
            moreHref={publishedHonors.length > featuredHonors.length ? '/honors' : undefined}
          />
        )
      }

      <PostsSection items={publishedPostCollections} counts={postCounts} />
    </div>
    <Quote class='mt-12' />
  </main>
</PageLayout>

<style>
  .home-about {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .home-about h2 {
    margin: 0;
    color: hsl(var(--foreground));
    font-size: 1.5rem;
    font-weight: 600;
  }

  .about-content {
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  .about-copy {
    max-width: 72rem;
  }

  .about-copy p {
    margin: 0;
    color: hsl(var(--foreground));
    font-size: 1.05rem;
    line-height: 1.75;
  }

  .about-copy p + p {
    margin-top: 1.2rem;
  }

  .about-copy strong {
    color: hsl(var(--primary));
    font-weight: 600;
  }

</style>
