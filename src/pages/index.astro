---
import type { CollectionEntry } from 'astro:content'

import { Quote } from 'astro-pure/advanced'
import { getBlogCollection, sortMDByDate } from 'astro-pure/server'
import { Button } from 'astro-pure/user'
import HonorsSection from '@/components/honors/HonorsSection.astro'
import PageLayout from '@/layouts/BaseLayout.astro'
import EducationSection from '@/components/home/EducationSection.astro'
import PostsSection from '@/components/home/PostsSection.astro'
import ProfileIntro from '@/components/home/ProfileIntro.astro'
import Section from '@/components/home/Section.astro'
import ProjectsSection from '@/components/projects/ProjectsSection.astro'
import config, { education, honors, projects } from '@/site-config'

const MAX_POSTS = 2
const allPosts = (await getBlogCollection()) as CollectionEntry<'blog'>[]
const allPostsByDate = sortMDByDate(allPosts).slice(0, MAX_POSTS) as CollectionEntry<'blog'>[]
const publishedHonors = honors.filter((honor) => !honor.draft)
const featuredHonors = publishedHonors.slice(0, 2)
const publishedProjects = projects.filter((project) => !project.draft)
const featuredProjects = publishedProjects.slice(0, 2)

const imagePath = config.logo.src
const images = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/*.{jpeg,jpg,png,gif,avif,webp}'
)
if (!images[imagePath])
  throw new Error(
    `"${imagePath}" does not exist in glob: "src/assets/*.{jpeg,jpg,png,gif,avif,webp}"`
  )
const avatar = (await images[imagePath]()).default
---

<PageLayout meta={{ title: 'Home' }} highlightColor='#659EB9'>
  <main class='flex w-full flex-col items-center'>
    <div class='w-full md:w-4/5 lg:w-5/6'>
      <ProfileIntro {avatar} />
    </div>

    <div id='content' class='animate flex flex-col gap-y-10 md:w-4/5 lg:w-5/6'>
      <Section title='About'>
        <p class='text-muted-foreground'>Developer / Designer</p>
        <p class='text-muted-foreground'>
          Lorem ipsum dolor sit amet, vidit suscipit at mei. Quem denique mea id. Usu ei regione
          indoctum dissentiunt, cu meliore fuisset mei, vel quod voluptua ne. Ex dicat impedit mel,
          at eum oratio possit voluptatum.
        </p>
        <Button title='More about me' class='w-fit self-end' href='/about' variant='ahead' />
      </Section>
      <EducationSection items={education} />
      <ProjectsSection
        items={featuredProjects}
        moreHref={publishedProjects.length > featuredProjects.length ? '/projects' : undefined}
      />
      {
        featuredHonors.length > 0 && (
          <HonorsSection
            items={featuredHonors}
            moreHref={publishedHonors.length > featuredHonors.length ? '/honors' : undefined}
          />
        )
      }

      <PostsSection items={allPostsByDate} />
    </div>
    <Quote class='mt-12' />
  </main>
</PageLayout>
