---
import ProjectCards from '@/components/projects/ProjectCards.astro'
import PageLayout from '@/layouts/CommonPage.astro'
import { projects } from '@/site-config'

const publishedProjects = projects.filter((project) => !project.draft)
---

<PageLayout title='Projects'>
  {
    publishedProjects.length > 0 ? (
      <div class='not-prose'>
        <ProjectCards items={publishedProjects} />
      </div>
    ) : (
      <p class='text-muted-foreground'>No projects have been added yet.</p>
    )
  }
</PageLayout>
